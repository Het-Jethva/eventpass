# EventPass Production & Development Environment Variables

# Neon PostgreSQL Database Connection String
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# For local development against the Postgres in compose.yaml, point DATABASE_URL
# at it instead. Its ports are deliberately non-default:
# `docker compose up -d`, then `npm run db:migrate`.
# DATABASE_URL="postgresql://postgres:postgres@localhost:54432/eventpass"

# WebSocket bridge for a local Postgres, so `@neondatabase/serverless` can reach
# it. Optional — defaults to the localhost:54444 that compose.yaml publishes,
# and is ignored entirely for a hosted (Neon) DATABASE_URL.
# NEON_WS_PROXY=localhost:54444

# Platform Administrator Emails (comma-separated)
PLATFORM_ADMIN_EMAILS="admin@example.com"

# Authentication Secrets
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://eventpass.hetjethva.tech

# Application Base URL
NEXT_PUBLIC_APP_URL=https://eventpass.hetjethva.tech

# Resend Transactional Email & Signed Webhook Secret
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=EventPass <noreply@mail.hetjethva.tech>
RESEND_WEBHOOK_SECRET=whsec_replace_me

# ECDSA Ticket Signing Keys
TICKET_SIGNING_KEY_ID=2026-01
TICKET_SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----
TICKET_PUBLIC_KEYS_JSON={"2026-01":"-----BEGIN PUBLIC KEY-----\\nreplace_me\\n-----END PUBLIC KEY-----"}
