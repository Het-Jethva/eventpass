# Local Postgres from compose.yaml. Replace with your hosted URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:54432/eventpass

# Public origin, without a path. Use your deployed HTTPS origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional comma-separated allowlist for platform operations.
PLATFORM_ADMIN_EMAILS=

# Transactional email. Use a sender on your verified domain.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=EventPass <tickets@example.com>
RESEND_WEBHOOK_SECRET=whsec_replace_me

# Replace these three lines with the output of npm run keys:generate.
TICKET_SIGNING_KEY_ID=replace_me
TICKET_SIGNING_PRIVATE_KEY_PEM=replace_me
TICKET_PUBLIC_KEYS_JSON={}

# Optional local WebSocket bridge, ignored for hosted Neon databases.
# NEON_WS_PROXY=localhost:54444

# Optional independent throttle HMAC secret. Defaults to BETTER_AUTH_SECRET.
# THROTTLE_SECRET=replace-with-at-least-32-random-characters
