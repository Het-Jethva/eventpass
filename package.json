{
  "name": "eventpass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "vercel-build": "npm run db:migrate && npm run build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "node scripts/test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "verify": "npm run check && npm test && npm run build",
    "test:db": "node scripts/test.mjs --database",
    "keys:generate": "node scripts/generate-ticket-keys.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.4.5",
    "@serwist/next": "^9.5.13",
    "@tabler/icons-react": "^3.45.0",
    "@zxing/browser": "^0.2.1",
    "better-auth": "~1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    },
    "glob": "^14.0.4",
    "minimatch@>=7 <11": "^11.0.5",
    "zod": "$zod"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "type": "module"
}
