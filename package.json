    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    },
    "brace-expansion@1": "^1.1.17",
    "brace-expansion@5": "^5.0.9",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
