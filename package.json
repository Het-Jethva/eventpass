    "@tabler/icons-react": "^3.45.0",
    "@zxing/browser": "^0.2.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
